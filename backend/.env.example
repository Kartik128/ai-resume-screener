# Application Configuration
PROJECT_NAME="AI Resume Screener & Candidate Ranking SaaS"
API_V1_STR="/api/v1"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True

# Security
SECRET_KEY="CHANGE_THIS_IN_PRODUCTION_SECRET_KEY_KEY_KEY_KEY"
ACCESS_TOKEN_EXPIRE_MINUTES=11520
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# Database Connection (Async for FastAPI runtime, Sync for Alembic)
DATABASE_URL="sqlite+aiosqlite:///./sql_app.db"
SYNC_DATABASE_URL="sqlite:///./sql_app.db"

# PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ai_screener_db"
# SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_screener_db"

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379/0"
